{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/per_step_clip__mpe__simple_spread__medium",
  "source_checkpoint": "${CKPT_ROOT}/simple_spread_medium/checkpoint_1000000.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "continuous"
  },
  "environment": {
    "family": "mpe",
    "task": "simple_spread",
    "runtime_dir": "envs/mpe/runtimes/mpe_rt1",
    "data_root": "${DATA_ROOT}/mpe",
    "action_dim": 2,
    "n_envs": 40,
    "workers": 2
  },
  "online": {
    "steps": 50000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 2e-05,
    "critic_lr": 0.0003,
    "epochs": 4,
    "batch_size": 256,
    "clip": 0.2,
    "target_kl": 0.02,
    "max_grad_norm": 0.5,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "critic_warmup_iters": 1,
    "ratio_mode": "per_step"
  },
  "experiment": {
    "online_env_steps": 50000000,
    "benchmark": "mpe"
  }
}
