{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/smac__2s3z__poor",
  "source_checkpoint": "${CKPT_ROOT}/2s3z_Poor/checkpoint_final.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "discrete",
    "network_dtype": "float64"
  },
  "environment": {
    "family": "smac",
    "task": "2s3z",
    "runtime_dir": "envs/smac/runtimes/smac_rt3",
    "n_envs": 8,
    "project_root": "envs/smac/runtimes/smac_rt3/project",
    "sc2path": "${SC2PATH}",
    "worker_log_dir": "outputs/smac__2s3z__poor/worker_logs"
  },
  "online": {
    "steps": 50000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 2e-05,
    "critic_lr": 0.0003,
    "epochs": 4,
    "batch_size": 256,
    "clip": 0.2,
    "target_kl": 0.02,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5
  },
  "experiment": {
    "benchmark": "smac",
    "task_dataset": "2s3z_Poor",
    "offline_updates": 1000000,
    "online_env_steps": 50000000
  }
}
