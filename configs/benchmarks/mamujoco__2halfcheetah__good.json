{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/mamujoco__2halfcheetah__good",
  "source_checkpoint": "${CKPT_ROOT}/2halfcheetah_Good/checkpoint_1000000.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "continuous",
    "network_dtype": "float64"
  },
  "environment": {
    "family": "mamujoco",
    "task": "2halfcheetah",
    "runtime_dir": "envs/mamujoco/runtimes/mamujoco_rt1",
    "data_root": "${DATA_ROOT}/mamujoco",
    "action_dim": 3,
    "n_envs": 40,
    "workers": 2,
    "library_paths": [
      "${MUJOCO_ROOT}/bin",
      "/usr/lib/nvidia"
    ]
  },
  "online": {
    "steps": 200000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 5e-06,
    "critic_lr": 0.0003,
    "epochs": 2,
    "batch_size": 256,
    "clip": 0.1,
    "target_kl": 0.01,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5,
    "kl_backtrack_steps": 4
  },
  "experiment": {
    "task_dataset": "2halfcheetah_Good",
    "offline_updates": 1000000,
    "online_env_steps": 200000000,
    "benchmark": "mamujoco"
  }
}
