{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/mpe__simple_tag__random",
  "source_checkpoint": "${CKPT_ROOT}/simple_tag_random/checkpoint_1000000.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "continuous",
    "network_dtype": "float64"
  },
  "environment": {
    "family": "mpe",
    "task": "simple_tag",
    "runtime_dir": "envs/mpe/runtimes/mpe_rt3",
    "n_envs": 40,
    "data_root": "${DATA_ROOT}/mpe",
    "action_dim": 2,
    "workers": 2,
    "worker_log_dir": "outputs/mpe__simple_tag__random/worker_logs"
  },
  "online": {
    "steps": 100000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 5e-06,
    "critic_lr": 0.0003,
    "epochs": 2,
    "batch_size": 256,
    "clip": 0.1,
    "target_kl": 0.01,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5,
    "kl_backtrack_steps": 12
  },
  "experiment": {
    "online_env_steps": 100000000,
    "benchmark": "mpe"
  }
}
