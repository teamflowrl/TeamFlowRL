{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda:0",
  "torch_threads": 1,
  "output": "outputs/mpe__simple_spread__random",
  "source_checkpoint": "${CKPT_ROOT}/simple_spread_random/offline_checkpoint.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.15,
    "learn_noise": true,
    "action_type": "continuous",
    "network_dtype": "float64",
    "min_std": 0.02,
    "max_std": 0.5
  },
  "environment": {
    "family": "mpe",
    "task": "simple_spread",
    "runtime_dir": "envs/mpe/runtimes/mpe_rt3",
    "n_envs": 40,
    "data_root": "${DATA_ROOT}/mpe",
    "action_dim": 2,
    "workers": 2
  },
  "online": {
    "steps": 50000000,
    "rollout_steps": 64,
    "eval_every": 250000,
    "eval_episodes": 20,
    "max_wall_seconds": 0,
    "save_every_seconds": 600,
    "evaluation_seeds": [
      10000,
      80000,
      90000
    ]
  },
  "ppo": {
    "actor_lr": 2e-05,
    "critic_lr": 0.0003,
    "epochs": 4,
    "batch_size": 256,
    "clip": 0.05,
    "target_kl": 0.004,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5,
    "kl_normalization": "steps",
    "kl_backtrack_steps": 6,
    "entropy_coef": 0.001,
    "entropy_coef_anneal_steps": 20000000,
    "diagnostics_every": 10,
    "cache_old_transition_kl": true,
    "normalize_value_loss": false,
    "actor_lr_start": 1e-05,
    "actor_lr_warmup_steps": 1000000,
    "actor_lr_final": 1e-05,
    "actor_lr_schedule_steps": 50000000,
    "kl_check_scope": "minibatch",
    "critic_valuenorm": true
  },
  "experiment": {
    "offline_updates": 1000000,
    "online_env_steps": 50000000,
    "benchmark": "mpe"
  }
}
