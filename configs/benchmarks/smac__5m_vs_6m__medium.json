{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/smac__5m_vs_6m__medium",
  "source_checkpoint": "${CKPT_ROOT}/5m_vs_6m_Medium/checkpoint_final.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "discrete"
  },
  "environment": {
    "family": "smac",
    "task": "5m_vs_6m",
    "runtime_dir": "envs/smac/runtimes/smac_rt4",
    "project_root": "envs/smac/runtimes/smac_rt4/project",
    "sc2path": "${SC2PATH}",
    "n_envs": 8,
    "worker_log_dir": "outputs/smac__5m_vs_6m__medium/worker_logs"
  },
  "online": {
    "steps": 50000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 1e-05,
    "critic_lr": 0.0003,
    "epochs": 4,
    "batch_size": 256,
    "clip": 0.15,
    "target_kl": 0.015,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5,
    "kl_backtrack_steps": 12
  },
  "experiment": {
    "online_env_steps": 50000000,
    "benchmark": "smac"
  }
}
