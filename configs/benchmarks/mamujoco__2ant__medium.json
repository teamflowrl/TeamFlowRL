{
  "algorithm": "A_TF_MAPPO",
  "seed": 0,
  "device": "cuda",
  "torch_threads": 1,
  "output": "outputs/mamujoco__2ant__medium",
  "source_checkpoint": "${CKPT_ROOT}/2ant_Medium/checkpoint_1000000.pt",
  "policy": {
    "steps": 10,
    "initial_std": 0.1,
    "learn_noise": true,
    "action_type": "continuous",
    "network_dtype": "float64"
  },
  "environment": {
    "family": "mamujoco",
    "task": "2ant",
    "runtime_dir": "envs/mamujoco/runtimes/mamujoco_rt4",
    "data_root": "${DATA_ROOT}/mamujoco",
    "action_dim": 4,
    "n_envs": 40,
    "workers": 2
  },
  "online": {
    "steps": 100000000,
    "rollout_steps": 128,
    "eval_every": 250000,
    "eval_episodes": 20
  },
  "ppo": {
    "actor_lr": 2e-05,
    "critic_lr": 0.0003,
    "epochs": 4,
    "batch_size": 256,
    "clip": 0.2,
    "target_kl": 0.02,
    "critic_warmup_iters": 1,
    "reference_coef": 0.0,
    "bc_coef": 0.0,
    "max_grad_norm": 0.5
  },
  "experiment": {
    "task_dataset": "2ant_Medium",
    "offline_updates": 1000000,
    "online_env_steps": 100000000,
    "benchmark": "mamujoco"
  }
}
